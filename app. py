# 1. Page Configuration & Aesthetic UI Styling
st.set_page_config(
    page_title="MediGenius AI",
    page_icon="🩺",
    layout="centered",
)

# Clean Light Theme with High-Contrast Bold Dark Text
st.markdown("""
